# Option A: Google Cloud Vertex AI (open DeepSeek model for the brain + image model), one service account
LLM_PROVIDER=vertex
GCP_PROJECT_ID=
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-sa.json
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash-maas
IMAGE_PROVIDER=vertex
IMAGE_MODEL=gemini-2.5-flash-image

# Option B: any OpenAI-compatible endpoint (set LLM_PROVIDER= empty)
# Any OpenAI-compatible endpoint serving an open model (vLLM, Ollama, LM Studio, OpenRouter...)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=none
LLM_MODEL=qwen2.5:14b

# Audience memory: "sqlite" (default, no extra services) or "graphiti" (needs FalkorDB + an embeddings endpoint)
MEMORY_BACKEND=sqlite
# Audience: unset = one batched LLM judge per ad; oasis = MiroFish's OASIS feed (run `make audience-setup` first)
AUDIENCE_BACKEND=
EMBED_BASE_URL=
EMBED_MODEL=nomic-embed-text
EMBED_API_KEY=
# Graph database for Graphiti (MEMORY_BACKEND=graphiti): local Docker (`make falkordb`) or hosted, e.g. on GCP.
# Falls back to SQLite automatically if unreachable.
GRAPH_DB=falkordb
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# or GRAPH_DB=neo4j with:
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

DB_PATH=data/engine.db
# Running in Docker against an endpoint on this machine? use http://host.docker.internal:<port>/v1

LLM_TIMEOUT=60
LLM_RETRIES=3

# Images for approved concepts: gemini (needs billing) or openai (OpenAI-compatible images endpoint, e.g. local FLUX)
IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_BASE_URL=
IMAGE_API_KEY=
