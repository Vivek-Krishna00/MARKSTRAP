# Every model and service below is open source / open weight.

# ---- Brain: open-weight model behind an OpenAI-compatible endpoint ----
# Option A: DeepSeek (open weights) served on Google Cloud Vertex AI; auth = gcloud Application Default Credentials
LLM_PROVIDER=vertex
GCP_PROJECT_ID=
GCP_LOCATION=global
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash-maas
# Option B (set LLM_PROVIDER= empty): any OpenAI-compatible server for an open model (vLLM, Ollama, LM Studio...)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=qwen2.5:14b
LLM_TIMEOUT=60
LLM_RETRIES=3

# ---- Audience: unset = one batched judge per ad; oasis = MiroFish's OASIS feed (run `make audience-setup` first)
AUDIENCE_BACKEND=

# ---- Memory: sqlite (default, no services) or graphiti (Graphiti on a graph DB; falls back to SQLite if unreachable)
MEMORY_BACKEND=sqlite
MEMORY_NAMESPACE=                # e.g. test- for experiments, so they never pollute campaign memory
GRAPH_DB=falkordb                # falkordb (FALKORDB_*) or neo4j (NEO4J_*); local Docker (`make falkordb`) or hosted
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Embeddings for Graphiti: open model behind an OpenAI-compatible endpoint, e.g. Ollama + nomic-embed-text
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=nomic-embed-text
EMBED_API_KEY=ollama

# ---- Images for approved concepts: open-weight model behind an OpenAI-compatible images endpoint (parked)
# e.g. FLUX.1-schnell (Apache-2.0) via LocalAI or a diffusers server
IMAGE_BASE_URL=
IMAGE_MODEL=flux.1-schnell
IMAGE_API_KEY=

DB_PATH=data/engine.db
# Running in Docker against an endpoint on this machine? use http://host.docker.internal:<port>/v1
